# Plantilla para producción. Copiar a /opt/libros-api/.env en el VPS.
# INVITATION_SIGNING_SECRET debe ser el MISMO valor que el .env de desarrollo
# (los tokens de invitación son determinísticos y deben sobrevivir restarts).
DATABASE_URL="postgresql://postgres.<project_ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?schema=public"
PORT=3000
CORS_ORIGIN="https://milibrosorpresa.com,https://www.milibrosorpresa.com"
SUPABASE_JWT_ISSUER="https://yukgwouhyahhvylxycim.supabase.co/auth/v1"
SUPABASE_JWKS_URL="https://yukgwouhyahhvylxycim.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_SEND_EMAIL_HOOK_SECRET="v1,whsec_..."
ADMIN_EMAILS="luis.montoya.j@gmail.com"
APP_URL="https://milibrosorpresa.com"
INVITATION_SIGNING_SECRET="mismo-valor-que-en-.env"
STRIPE_WEBHOOK_SECRET="whsec_..."
RESEND_API_KEY="re_..."
DEEPSEEK_API_KEY="sk-..."
