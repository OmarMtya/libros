# Configuración del proyecto e2e. Copiar este archivo a `.env` y llenar los valores.
# NUNCA subir `.env` (está en .gitignore). Usar secretos en el CI (GitHub Actions / cron).

# URL del frontend de producción
FRONTEND_URL=https://milibrosorpresa.com

# URL base de la API de producción (sin "/v1" final; el código lo agrega)
API_URL=https://api.milibrosorpresa.com

# Correo SIEMPRE reutilizado. Al terminar los tests se elimina la cuenta y todos sus datos,
# por lo que al siguiente día se puede volver a registrar con el mismo correo.
E2E_EMAIL=hola@milibrosorpresa.com

# Contraseña fija para el usuario de prueba (el registro la usa cada día tras el cleanup).
E2E_PASSWORD=CAMBIAR_ESTA_CONTRASENA_FUERTE_123!

# Nombre visible que se usa al registrarse.
E2E_FULL_NAME=Cuenta E2E

# Conexión a la base de datos de producción (Supabase Postgres, pooler).
# Es la MISMA DATABASE_URL de /opt/libros-api/.env pero con sslmode=require.
# Se usa SOLO para confirmar el email tras el registro y para eliminar toda la data
# del usuario de prueba al final (auth + tablas públicas).
# OJO: rol con permisos para escribir en el esquema auth (postgres.<ref> lo tiene).
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require
